# ── Database ──────────────────────────────────────────────────────────────────
# On Neon: use the POOLED connection string (hostname contains "-pooler"),
# not the direct one — the direct endpoint's connection ceiling is exhausted
# fast once more than one backend instance is running. Find it in the Neon
# dashboard → Connection Details → toggle "Pooled connection".
DATABASE_URL=postgresql://user:password@localhost:5432/hirebot
# Per-process pg.Pool size. Keep (instances × DB_POOL_MAX) comfortably under
# your Neon plan's max connections as you scale out horizontally.
DB_POOL_MAX=10

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_hex
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# ── Clerk ─────────────────────────────────────────────────────────────────────
# From Clerk dashboard → API Keys
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...

# NOTE: CLERK_OAUTH_CLIENT_ID must match the root .env's value exactly (same Clerk app).
CLERK_OAUTH_CLIENT_ID=your_clerk_oauth_client_id

# ── Razorpay ──────────────────────────────────────────────────────────────────
# One-time payments only (prepaid session packs — see lib/razorpay.ts's
# SESSION_PACKS); pricing is defined inline in code, nothing to set up in
# the Razorpay dashboard for it.
# From Razorpay dashboard → Settings → API Keys (use test-mode keys first)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# From Razorpay dashboard → Settings → Webhooks → your endpoint → Secret.
# Also used to verify the Payment Link success callback (see
# billing.ts's /verify-callback) — Razorpay signs both the same way.
RAZORPAY_WEBHOOK_SECRET=...

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
